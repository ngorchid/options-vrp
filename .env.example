# Options VRP paper system — copy to .env and fill in.
BUDGET=75000
# GATE OFF (2026-08-15). 99 = always open. The gate sold only in contango (VIX/VIX3M < 1.00),
# but it is ENTRY-ONLY: nothing closes a spread when it shuts, so a position opened in contango
# rides a vol spike untouched for its remaining 30-45 days. 7 of the 8 largest historical losses
# were entered with it wide open. Measured on the 13.2yr OPRA series at the CORRECTED 6% cost:
# gate OFF +0.85 Sharpe vs ON +0.62, with no drawdown benefit either way (-5,244 both). Same
# conclusion at the old wrong cost assumption (+0.65 vs +0.43), so it survives the cost fix.
# Set REGIME_THR=1.00 to restore it.
REGIME_THR=99
VRP_MIN=0.02           # skip names with ATM IV - RV20 below this (vol points)
STOP_MULT=0            # 0 = NO STOP (backtested: a 2x stop costs ~$117/trade). >0 re-enables
MAX_COST_FRAC=0.25     # reject a spread whose combo bid-ask exceeds this share of the credit
                       #   (break-even is ~31%; single names measured at 59-65%)
SKIP_IF_NO_QUOTE=1     # 1 = skip when no live combo quote (needs an IB mkt-data sub); 0 = trade anyway
COMMISSION_PER_CONTRACT=0.65   # USD per contract, ONE side. IB direct ~0.65; LYNX charges 3.50.
                       #   A vertical is 4 contract-sides per round trip, and it does NOT
                       #   amortise with size -- at LYNX rates cheap options are untradeable.

# IB paper Gateway/TWS (own clientId so it coexists with magic-formula=5, trend-overlay=6)
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=7

# Daily email (gmail app password)
EMAIL_USER=
EMAIL_PASS=
TO_EMAIL=
